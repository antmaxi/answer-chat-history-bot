# Copy to .env and fill in. All values are optional except the keys you need
# for the milestones you've reached: M1-M3 need none of them.

# DB_PATH=data/answerbot.db
# LOG_LEVEL=INFO
# LOG_PATH=                    # default: answerbot.log next to the DB; "off" for stderr only

# --- Embeddings (local, no key needed) ---
# EMBED_MODEL=intfloat/multilingual-e5-small
# EMBED_DIM=384

# --- Windowing ---
# WINDOW_GAP_SECONDS=1800
# WINDOW_MAX_MSGS=25

# --- Speaker names ---
# SPEAKER_LABEL=name    # name (public name, User N fallback) | id (anonymous) | export (contact labels)

# --- Retrieval ---
# TOP_K=8
# WEIGHT_VECTOR=1.0
# WEIGHT_KEYWORD=0.7

# --- Answering (M4+) ---
# LLM_PROVIDER=claude          # claude | gemini | groq | openrouter | ollama | cursor
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=              # or GOOGLE_API_KEY
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# CURSOR_API_KEY=              # from https://cursor.com/dashboard/api (Pro+)
#                              # venv: pip install 'answerbot[cursor]'
#                              # Docker image already includes cursor-sdk
# OPENROUTER_HTTP_REFERER=     # optional; OpenRouter uses it to attribute traffic
# OPENROUTER_APP_TITLE=answer-chat-history-bot
# ANSWER_MODEL=claude-sonnet-5 # groq: openai/gpt-oss-20b
#                              # openrouter: openai/gpt-oss-20b:free (or any model id)
#                              # gemini: gemini-2.5-flash
#                              # cursor: composer-2.5 (Cursor Models pool)
# ANSWER_MAX_TOKENS=8192       # Groq/OpenRouter; includes reasoning tokens
# ANSWER_MAX_REQUEST_TOKENS=0  # prompt+completion cap; Groq defaults to 8000 TPM
# ANSWER_COOLDOWN_SECONDS=8
# ANSWER_MAX_PER_USER_PER_HOUR=0  # LLM answers per user; 0 disables
# ANSWER_MAX_PER_HOUR=0           # LLM answers for the whole bot; 0 disables
# QUERY_LOG=1
# LLM_TIMEOUT=60
# OLLAMA_HOST=http://localhost:11434
# Inside Docker, Ollama on the host is http://host.docker.internal:11434

# --- Telegram bot (M5+) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=            # supergroup Bot API id, e.g. -1001234567890
#                              # a positive id is stored as -100<id>
# ADMIN_USER_IDS=              # DMed up/down and ERROR logs
# GITHUB_REPO=https://github.com/antmaxi/answer-chat-history-bot
# DISPLAY_UTC_OFFSET_HOURS=2   # wall-clock times in /info (UTC+2)
# LIVE_REINDEX_EVERY=20
# LIVE_LOOKBACK_HOURS=6
# MEMBERSHIP_CACHE_SECONDS=300
